{
  "expo": {
    "name": "my-app",
    "slug": "my-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMotionUsageDescription": "이 앱은 사용자의 걸음 수를 추적하여 건강 정보를 제공합니다.",
        "NSCameraUsageDescription": "이 앱은 사진을 찍기 위해 카메라를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "이 앱은 사진에 접근하여 저장된 이미지를 사용할 수 있습니다.",
        "NSLocationWhenInUseUsageDescription": "이 앱은 사용자의 위치 정보를 사용합니다."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.riny127.myapp",
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "INTERNET",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "PACKAGE_USAGE_STATS",
        "ACTIVITY_RECOGNITION",
        "INTERNET",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "PACKAGE_USAGE_STATS"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f6eefeb7-e08b-448c-8f6b-425573dc0abf"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f6eefeb7-e08b-448c-8f6b-425573dc0abf"
    }
  }
}
